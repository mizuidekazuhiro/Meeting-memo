# Auth
API_TOKEN=replace-with-shared-bearer-token

# OpenAI
OPENAI_API_KEY=sk-...

# Dropbox (either direct access token OR refresh-token flow)
DROPBOX_ACCESS_TOKEN=
DROPBOX_REFRESH_TOKEN=
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

# Workers callback
WORKERS_CALLBACK_URL=https://your-workers.example.com/api/interviews/transcription-callback
WORKERS_CALLBACK_TOKEN=replace-with-interview-webhook-secret

# Audio / ffmpeg config
TARGET_CHUNK_DURATION_SEC=300
MAX_TRANSCRIBE_DURATION_SEC=1400
PRIMARY_AUDIO_FORMAT=m4a
FALLBACK_AUDIO_FORMAT=wav
ENABLE_AUDIO_FALLBACK=true
TRANSCRIBE_DIARIZATION_ENABLED=false
TRANSCRIBE_LANGUAGE=ja
DIARIZATION_CHUNKING_STRATEGY=auto
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
TMP_DIR=/tmp
